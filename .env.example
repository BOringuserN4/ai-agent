# 复制本文件为 .env 并填入你的密钥：cp .env.example .env
# DeepSeek 对话模型 key（必填）
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 阿里云 DashScope 长期记忆 embedding key（长期记忆功能需要用，去 https://bailian.console.aliyun.com 开通）:
# text-embedding-v3 用于把记忆文本向量化，OpenAI 兼容接口，速度快。
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Langfuse 可观测性 key（第 10 周，可选。不配则自动降级，不影响核心功能）:
# 1. 自部署 Langfuse 后，去其 Web UI（如 http://localhost:3000）创建项目，
#    拿到 Project 的 Public Key 和 Secret Key。
# 2. Host 填你的 Langfuse 服务地址（本地部署默认 http://localhost:3000）。
# 3. 配好后，core.py 的 run_traced() 会自动上报轨迹/成本。
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_HOST=http://localhost:3000
